{
  "manifest_version": 3,
  "name": "Adversarial Cognitive Mesh",
  "version": "1.0.0",
  "description": "Multi-agent AI cybersecurity system — real-time threat detection & response",
  "permissions": ["activeTab", "storage", "tabs"],
  "host_permissions": ["http://localhost:8765/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Adversarial Cognitive Mesh",
    "default_icon": {
      "16":  "icons/icon16.png",
      "48":  "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16":  "icons/icon16.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
